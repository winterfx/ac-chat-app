# The agent-compose daemon this app holds its conversations with. Use https
# when the daemon is not on this host: the bearer token below travels with
# every request.
AC_DAEMON=http://127.0.0.1:7411

# The daemon's control-plane bearer token. This is the daemon's own variable
# name, so the same .env configures both sides; leave it empty when the daemon
# runs with authentication disabled.
AGENT_COMPOSE_AUTH_TOKEN=

# Where the UI listens.
AC_LISTEN=127.0.0.1:7500

# Accounts and the chat list. Defaults to ~/.ac-chat-app/state.json.
# AC_STATE=/var/lib/ac-chat-app/state.json

# Extra origins allowed to open a chat socket, comma separated.
# AC_ALLOW_ORIGIN=https://chat.example.com
